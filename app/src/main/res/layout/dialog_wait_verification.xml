<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:paddingTop="20dp"
    android:paddingBottom="40dp"
    android:background="@drawable/dialog_round_back_ground">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_info_24"
        android:background="@color/cvBackground"
        android:padding="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/txt_processing"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/processing"
        android:textColor="@color/textColorPrimary"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar"/>

    <ImageButton
        android:id="@+id/ib_verification_done"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/base_line_check_48"
        android:background="@color/cvBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/txt_verification_done"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="@string/verification_done"
        android:textColor="@color/textColorPrimary"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ib_verification_done"/>



</androidx.constraintlayout.widget.ConstraintLayout>